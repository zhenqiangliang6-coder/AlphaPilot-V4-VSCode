# ===========================
# AlphaPilot OS 统一配置中心模板
# ===========================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填入你的真实配置值
# 3. .env 文件已加入 .gitignore，不会被提交
# ===========================

# =========================
# Redis 配置（Upstash - 统一使用）
# =========================

UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Redis 类型：auto | upstash | memory
# - auto: 根据模型自动选择（推荐）
# - memory: 调试模式（本地内存）
REDIS_TYPE=auto
USE_MEMORY_REDIS=false

# Route only these model queues through the local Docker Redis; empty uses cloud auto-routing.
LOCAL_REDIS_MODELS=maas,modelscope
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 默认模型
DEFAULT_MODEL=qwen

# =========================
# API Key 配置
# =========================

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_PROXY_URL=http://localhost:8000
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=300

# 阿里云 DashScope (通义千问)
DASHSCOPE_API_KEY=your-dashscope-api-key

# 火山引擎
VOLC_API_KEY=your-volc-api-key
VOLC_DEEPSEEK_API_KEY=your-volc-deepseek-api-key

# Tencent MaaS (Hunyuan)
TENCENT_MAAS_API_KEY=your-tencent-maas-api-key
TENCENT_MAAS_BASE_URL=https://tokenhub.tencentmaas.com/v1
TENCENT_MAAS_MODEL=hy4-preview

# ModelScope
MODELSCOPE_API_KEY=your-modelscope-api-key
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
MODELSCOPE_MODEL=Qwen/Qwen3.8-Flash-Next
MODELSCOPE_CONNECT_TIMEOUT_SECONDS=10
MODELSCOPE_READ_TIMEOUT_SECONDS=600
MODELSCOPE_MAX_RETRIES=3
MODELSCOPE_RETRY_BACKOFF_SECONDS=2
MODELSCOPE_CHECKPOINT_TTL_SECONDS=604800

# =========================
# Local LLM 配置（LM Studio）
# =========================

# LM Studio API 基础地址
# 查找方式：LM Studio -> Server -> Local Inference Server -> 查看端口
LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# Local LLM 模型名称（必须与 LM Studio 加载的模型一致）
LOCAL_LLM_MODEL=google/gemma-4-e4b

# Local LLM API 类型：lm_studio | ollama
LOCAL_LLM_API_TYPE=lm_studio

# =========================
# Node API 配置
# =========================

NODE_API_URL=http://localhost:3000