# .env.example

# Example environment variables for the ModelRouter project

# API key for accessing external model providers
DASHSCOPE_API_KEY=your_api_key_here

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# SQLite database configuration
SQLITE_DB_PATH=./data/database.db

# Hugging Face API configuration
HF_API_KEY=your_huggingface_api_key_here

# Model scoring configuration
MODEL_SCORING_THRESHOLD=0.75

# Cache configuration
CACHE_EXPIRATION_TIME=3600  # in seconds

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/model_router.log

# Other configurations can be added as needed